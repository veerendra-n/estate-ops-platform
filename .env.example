# Copy to .env (never commit .env). Values here are placeholders for a laptop, not real secrets.
POSTGRES_PASSWORD=change-me-local-only
NEO4J_PASSWORD=change-me-local-only
CONSOLE_TOKEN=change-me-local-only
LAB_INTAKE_TOKEN=change-me-lab-intake
CONTOSO_INTAKE_TOKEN=change-me-contoso-intake

# An approval nobody answers escalates the case after this many hours.
# APPROVAL_TIMEOUT_HOURS=72

# Leave empty to run with deterministic diagnosis only (no model calls, no AI cost).
ANTHROPIC_API_KEY=
# DIAGNOSIS_MODEL=claude-opus-5-5
# DIAGNOSIS_EFFORT=low

# Real Semaphore and OpenObserve (lab). Defaults point at the fakes container.
# SEMAPHORE_URL=https://semaphore.example.net
# SEMAPHORE_TOKEN=
# OPENOBSERVE_URL=https://openobserve.example.net
# OPENOBSERVE_USER=
# OPENOBSERVE_PASSWORD=
# CATALOG_FILE=/catalog/catalog.json   # an ops-foundation build/catalog.json mounted into the containers

# Where engineers reach the console (links in tickets and cards; the SSO callback is PUBLIC_URL/auth/callback).
# PUBLIC_URL=https://ops.example.net

# Console sign-in with OpenID Connect. Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# Google: https://accounts.google.com. Without OIDC_ISSUER the console uses CONSOLE_TOKEN (local only).
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED=            # optional: Entra tenant ids (tid) or Google Workspace domains (hd), comma separated
# SESSION_SECRET=          # required with OIDC_ISSUER: a long random string

# HaloPSA (tickets per case). Compose defaults to the fake. Ids per customer are in config/tenants.yml.
# HALO_URL=https://yourinstance.halopsa.com
# HALO_CLIENT_ID=
# HALO_CLIENT_SECRET=
# HALO_TENANT=             # only for Halo-hosted instances that need ?tenant=
# HALO_TICKET_TYPE_ID=1
# HALO_CLOSED_STATUS_ID=9  # check GET /api/Status on your instance

# Teams: one Workflows webhook URL per customer channel, named in tenants.yml (teams_webhook_env).
# LAB_TEAMS_WEBHOOK=

# NetBox discovery into the estate graph (v2 tokens nbt_... or legacy tokens both work).
# NETBOX_URL=https://netbox.example.net
# NETBOX_TOKEN=
# DISCOVERY_INTERVAL_MINUTES=60
